{
  "crons": [
    {
      "path": "/api/cron/owner-work",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/owner-brief",
      "schedule": "0 13,14 * * *"
    },
    {
      "path": "/api/cron/community-education",
      "schedule": "0 14 * * *"
    },
    {
      "schedule": "*/5 * * * *",
      "path": "/api/cron/owner-health"
    },
    {
      "path": "/api/cron/indicator-browser",
      "schedule": "*/5 * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "functions": {
    "api/founder-native-render.py": {
      "maxDuration": 300,
      "regions": [
        "iad1"
      ],
      "includeFiles": "{scripts/founder-renderer/**,app/lib/business-os/founder-render-catalog.json,app/lib/business-os/founder-native-runtime.json,public/indicators/**,public/fonts/darth-social/**}",
      "excludeFiles": "{node_modules/**,.next/**,.git/**,docs/**,tests/**,artifacts/**,public/growth-sprint/**,public/daily-social/**}"
    }
  },
  "installCommand": "npm ci --ignore-scripts"
}
